# Copy this file to backend/.env for local development.
# In Render, set DATABASE_URL in the service environment instead.
# Copy the Session pooler URI from Supabase Dashboard > Connect.
# Keep its project-qualified username and exact host; change only the password.
# URL-encode reserved characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
PORT=8000
